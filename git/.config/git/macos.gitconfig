[user]
	signingkey = /Users/samuelhe/.ssh/id_ed25519_github.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /Users/samuelhe/.ssh/allowed_signers
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[include]
	path = ~/.config/delta/themes.gitconfig
[delta]
	navigate = true
	line-numbers = true
	features = arctic-fox
	syntax-theme = Dracula
